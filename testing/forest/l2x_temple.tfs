# Scripted route checkpoint.
# Requires your own matching saved-game state; distributed seeds are omitted.
# Ruined Temple warp gate (default), then ~5,000 pads of scripted walking/driving/combat.
budget 3600s
stall 900 hard 3600
watchdog warn 30 600
defaults hold=3 gap=6 timeout=3000vs
dumpsteps on

boot:     wait seen /FMV/NATTRACT.PSS timeout 4000vs
          wait pads 4
title:    press start until pads 200 every 40 max 5
          mark main_menu
menu:     press down
          wait pads 20
          mark main_continue_game
          press cross
          wait pads 60 timeout 9000vs
          mark saved_games
loadsave: press cross until cd /SOUND/MUSIC/UI_MAIN.MS every 120 max 2 timeout 3000vs
hubload:  wait pads 40 timeout 9000vs
          mark hub_view_mission_sites
missions: press cross until cd /FMV/LEVELS/N01AMA.M2V every 60 max 2 timeout 1500vs
          wait pads 4
          mark globe
globe:    press cross hold=2 gap=4
          wait pads 30 timeout 9000vs
          mark warp_gate_screen
enter:    press cross until cd /TFA.ZIP@1940-44053 or cd /SOUND/MUSIC/AMAZON.MS or cd /SOUND/MUSIC/TEMPLE.MS every 30 max 3 timeout 3000vs
          mark level_load
ingame:   wait pads 200 timeout 20000vs
          mark warp_in
          wait pads 300 timeout 20000vs
          mark spawn
explore: stick 128 0 128 128
          wait pads 120 timeout 20000vs
          stick none
          mark x01
          stick 128 0 70 128
          wait pads 40 timeout 20000vs
          stick 128 0 128 128
          press r1
          wait pads 160 timeout 20000vs
          press r1
          wait pads 10
          stick none
          mark x02
          stick 255 60 128 128
          wait pads 80 timeout 20000vs
          press l1
          wait pads 30
          press l2
          wait pads 60
          press r2
          wait pads 60
          stick 128 0 128 128
          wait pads 100 timeout 20000vs
          stick none
          mark x03
          stick none
          press triangle
          wait pads 60
          buttons cross
          stick 128 0 128 128
          wait pads 150 timeout 20000vs
          stick 40 0 128 128
          wait pads 60 timeout 20000vs
          stick 128 0 128 128
          wait pads 150 timeout 20000vs
          buttons none
          stick 128 128 128 128
          buttons r1
          wait pads 60 timeout 20000vs
          buttons none
          stick none
          press triangle
          wait pads 60
          stick none
          mark x04
          stick 128 0 220 128
          wait pads 60 timeout 20000vs
          buttons r1
          stick 128 0 128 128
          wait pads 200 timeout 20000vs
          buttons none
          stick none
          mark x05
          stick 225 0 128 128
          wait pads 100 timeout 20000vs
          press l1
          wait pads 20
          press l1
          wait pads 40
          stick 128 0 128 128
          wait pads 100 timeout 20000vs
          stick none
          mark x06
          stick 128 128 128 30
          wait pads 40 timeout 20000vs
          press r2
          wait pads 60
          stick 128 0 220 128
          wait pads 200 timeout 20000vs
          stick none
          mark x07
          stick none
          press triangle
          wait pads 60
          buttons cross
          stick 128 0 128 128
          wait pads 250 timeout 20000vs
          stick 40 0 128 128
          wait pads 40 timeout 20000vs
          stick 128 0 128 128
          wait pads 250 timeout 20000vs
          buttons none
          stick none
          press triangle
          wait pads 60
          stick none
          mark x08
          stick 128 0 220 128
          wait pads 40 timeout 20000vs
          stick 128 0 128 128
          press r1
          wait pads 160 timeout 20000vs
          press r1
          wait pads 10
          stick none
          mark x09
          stick 0 60 128 128
          wait pads 80 timeout 20000vs
          press l1
          wait pads 30
          press l2
          wait pads 60
          press r2
          wait pads 60
          stick 128 0 128 128
          wait pads 100 timeout 20000vs
          stick none
          mark x10
          stick none
          press triangle
          wait pads 60
          buttons cross
          stick 128 0 128 128
          wait pads 150 timeout 20000vs
          stick 220 0 128 128
          wait pads 60 timeout 20000vs
          stick 128 0 128 128
          wait pads 150 timeout 20000vs
          buttons none
          stick 128 128 128 128
          buttons r1
          wait pads 60 timeout 20000vs
          buttons none
          stick none
          press triangle
          wait pads 60
          stick none
          mark x11
          stick 128 0 190 128
          wait pads 60 timeout 20000vs
          buttons r1
          stick 128 0 128 128
          wait pads 200 timeout 20000vs
          buttons none
          stick none
          mark x12
          stick 30 0 128 128
          wait pads 100 timeout 20000vs
          press l1
          wait pads 20
          press l1
          wait pads 40
          stick 128 0 128 128
          wait pads 100 timeout 20000vs
          stick none
          mark x13
          stick 128 128 128 30
          wait pads 40 timeout 20000vs
          press r2
          wait pads 60
          stick 128 0 190 128
          wait pads 200 timeout 20000vs
          stick none
          mark x14
          stick none
          press triangle
          wait pads 60
          buttons cross
          stick 128 0 128 128
          wait pads 250 timeout 20000vs
          stick 40 0 128 128
          wait pads 40 timeout 20000vs
          stick 128 0 128 128
          wait pads 250 timeout 20000vs
          buttons none
          stick none
          press triangle
          wait pads 60
          stick none
          mark x15
          pass exploration finished
