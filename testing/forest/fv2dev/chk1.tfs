          mark cal_done
# pause -> SHOW OBJECTIVE
          press start
          wait pads 30 timeout 20000vs
          dump p_pause
          press down
          wait pads 20 timeout 20000vs
          dump p_down
          press cross
          wait lsn 1127430-1146821 timeout 900vs else continue
          mark p_objective_cue_or_timeout
          wait pads 30 timeout 3000vs else continue
          dump p_obj30
          press cross
          wait lsn 1127430-1146821 timeout 120vs else continue
          dump p_after_cross2
          press circle
          wait lsn 1127430-1146821 timeout 120vs else continue
          dump p_after_circle
          press triangle
          wait lsn 1127430-1146821 timeout 120vs else continue
          dump p_after_triangle
          press start
          wait lsn 1127430-1146821 timeout 120vs else continue
          dump p_after_start
          wait pads 60 timeout 3000vs else continue
          mark resumed
# other buttons in gameplay
          press select
          wait lsn 1127430-1146821 timeout 180vs else continue
          dump b_select
          press select
          wait lsn 1127430-1146821 timeout 180vs else continue
          dump b_select2
          press square
          wait lsn 1127430-1146821 timeout 120vs else continue
          dump b_square
          press circle
          wait lsn 1127430-1146821 timeout 120vs else continue
          dump b_circle
          press r3
          wait lsn 1127430-1146821 timeout 120vs else continue
          dump b_r3
          press l3
          wait lsn 1127430-1146821 timeout 120vs else continue
          dump b_l3
          mark chk1_end
          pass chk1 done
