# --- alive-check experiment: START -> pause menu, down -> SHOW OBJECTIVE, cross (does it read an audio cue?)
chk:      dump chk_before
          press start
          wait pads 30 timeout 20000vs
          dump chk_after_start
          press down
          wait pads 20 timeout 20000vs
          dump chk_after_down
          press cross
          wait lsn 1127430-1146821 timeout 900vs else continue
          mark chk_cue_or_timeout
          wait pads 30 timeout 3000vs else continue
          dump chk_30
          wait pads 60 timeout 3000vs else continue
          dump chk_90
          press triangle
          wait pads 30 timeout 3000vs else continue
          dump chk_after_triangle
          press circle
          wait pads 30 timeout 3000vs else continue
          dump chk_after_circle
          press start
          wait pads 60 timeout 3000vs else continue
          dump chk_after_start2
          pass c1 candidate done
