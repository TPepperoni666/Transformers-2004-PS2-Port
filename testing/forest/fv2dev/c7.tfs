# Route checkpoint.
# Requires your own matching saved-game state; distributed seeds are omitted.
budget 3600s
stall 900 hard 3600
watchdog warn 30 600
defaults hold=3 gap=6 timeout=3000vs
dumpsteps on

boot:     wait seen /FMV/NATTRACT.PSS timeout 4000vs
          wait pads 4
title:    press start until pads 200 every 40 max 5
          mark main_menu
menu:     press down
          wait pads 20
          mark main_continue_game
          press cross
          wait pads 60 timeout 9000vs
          mark saved_games
loadsave: press cross until cd /SOUND/MUSIC/UI_MAIN.MS every 120 max 2 timeout 3000vs
hubload:  wait pads 40 timeout 9000vs
          mark hub_view_mission_sites
missions: press cross until cd /FMV/LEVELS/N01AMA.M2V every 60 max 2 timeout 1500vs
          wait pads 4
          mark globe
globe:    press cross hold=2 gap=4
          wait pads 30 timeout 9000vs
          mark warp_gate_screen
enter:    press cross until cd /TFA.ZIP@1940-44053 or cd /SOUND/MUSIC/AMAZON.MS or cd /SOUND/MUSIC/TEMPLE.MS every 30 max 3 timeout 3000vs
          mark level_load
ingame:   wait pads 200 timeout 20000vs
          mark warp_in
          wait pads 300 timeout 20000vs
          mark spawn
