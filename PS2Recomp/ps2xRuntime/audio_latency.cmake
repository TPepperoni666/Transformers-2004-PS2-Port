# TEMP(transformers): compile tracked bridge together with raylib's private AUDIO state.
get_target_property(_audio_sources raylib SOURCES)
get_target_property(_audio_source_dir raylib SOURCE_DIR)
foreach(_audio_source IN LISTS _audio_sources)
    if(_audio_source MATCHES "(^|/)raudio\\.c$")
        get_filename_component(_audio_input "${_audio_source}" ABSOLUTE BASE_DIR "${_audio_source_dir}")
        file(READ "${_audio_input}" _audio_text)
        file(READ "${CMAKE_CURRENT_LIST_DIR}/src/lib/ps2_audio_latency_bridge.c" _audio_bridge)
        set(_audio_generated "${CMAKE_CURRENT_BINARY_DIR}/ps2_raudio_latency.c")
        file(WRITE "${_audio_generated}" "${_audio_text}\n${_audio_bridge}")
        list(REMOVE_ITEM _audio_sources "${_audio_source}")
        list(APPEND _audio_sources "${_audio_generated}")
    endif()
endforeach()
set_property(TARGET raylib PROPERTY SOURCES "${_audio_sources}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_audio_input}" "${CMAKE_CURRENT_LIST_DIR}/src/lib/ps2_audio_latency_bridge.c")
